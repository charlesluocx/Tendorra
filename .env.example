# Supabase (project: jwmduxiykcbarlktxtrb)
# Publishable/anon values are safe to expose to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://jwmduxiykcbarlktxtrb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BLF5_fxJmUgsc-BYszClaQ_vPSfDipX

# Service role key — server-only, never exposed to the client. Bypasses RLS.
# Get it from Supabase project settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra ID (Azure AD) app registration for the Outlook OAuth
# connection. Register an app at https://portal.azure.com > Entra ID > App
# registrations, add a web redirect URI of
# https://<your-deployed-domain>/api/auth/microsoft/callback (and
# http://localhost:3000/api/auth/microsoft/callback for local dev), and grant
# the delegated Microsoft Graph permissions: openid, profile, email,
# offline_access, User.Read, Mail.Read.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows both work/school and personal accounts. Use your tenant ID
# (or "organizations") to restrict sign-in to your Microsoft 365 org.
MICROSOFT_TENANT_ID=common

# Anthropic API key, used to parse tagged emails into activity-log entries.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend API key, used to email team invites and stale-project reminders.
# Get one at https://resend.com/api-keys. Optional — without it, invites
# still work but just show a link to copy and send manually, and
# stale-project reminders just don't get emailed (the dashboard's "Gone
# quiet" badge still works either way).
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account. Defaults to
# Resend's shared onboarding@resend.dev sender, which works without domain
# verification but is best for testing only.
RESEND_FROM_EMAIL=

# Used by /api/cron/stale-reminders (see .github/workflows/stale-reminders.yml)
# to build links back into the app from reminder emails, and to authenticate
# the scheduled job that calls that route. CRON_SECRET can be any random
# string — generate one with `openssl rand -hex 32`. Both also need to be set
# as a GitHub Actions repo variable (APP_URL) and secret (CRON_SECRET) for the
# scheduled workflow to call your deployed app.
APP_URL=http://localhost:3000
CRON_SECRET=

# Google OAuth app for the shared project-timeline Gmail inbox (one inbox per
# company, connected once by an owner/admin at /settings/inbox — see
# "Project timeline" in the README). Create a project at
# https://console.cloud.google.com, enable the "Gmail API" (not "Gmail MCP
# API"), then under APIs & Services > Credentials create an OAuth client ID
# (Web application) with a redirect URI of
# https://<your-deployed-domain>/api/auth/gmail/callback (and
# http://localhost:3000/api/auth/gmail/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
