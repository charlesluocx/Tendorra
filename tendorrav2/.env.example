# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the admin CRM to read across all tenants.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude: extracts events & milestones from dropped emails. Optional —
# without it, each email becomes a single timeline event.
ANTHROPIC_API_KEY=
